\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Prior work on the problem of updating annotations after a database release. ``Unmodified'': runs the program as is. ``Release\nobreakdash -aware'': reuses work when the database changes. ``Identical'': output equals a full run byte for byte. ``Per\nobreakdash -tool code'': requires code or formulas written for each program. $^\dagger $TARE\xspace  's pins, side files, groups, and reporting thresholds are declared as data on the command line; its core has no program\nobreakdash -specific code.}}{12}{table.caption.21}\protected@file@percent }
\newlabel{tab:prior}{{7}{12}{Prior work on the problem of updating annotations after a database release. ``Unmodified'': runs the program as is. ``Release\nobreakdash -aware'': reuses work when the database changes. ``Identical'': output equals a full run byte for byte. ``Per\nobreakdash -tool code'': requires code or formulas written for each program. $^\dagger $\sys 's pins, side files, groups, and reporting thresholds are declared as data on the command line; its core has no program\nobreakdash -specific code}{table.caption.21}{}}
\newlabel{tab:prior@cref}{{[table][7][]7}{[1][11][]12}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces \textbf  {Approximate versus exact.} Output of iSeqSearch's incremental DIAMOND after a Swiss\nobreakdash -Prot update, compared line by line with a full run. Its numbers are close, but only 1.3\% of lines match exactly and 133 lines report sequences the new release deleted. TARE\xspace  refuses this program and returns the stock run (exact, not faster).}}{12}{figure.caption.20}\protected@file@percent }
\newlabel{fig:idiamond}{{9}{12}{\textbf {Approximate versus exact.} Output of iSeqSearch's incremental DIAMOND after a Swiss\nobreakdash -Prot update, compared line by line with a full run. Its numbers are close, but only 1.3\% of lines match exactly and 133 lines report sequences the new release deleted. \sys refuses this program and returns the stock run (exact, not faster)}{figure.caption.20}{}}
