\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Why old results cannot simply be reused.} An E-value is a probability $P$ (fixed by the score) times the database size $Z$. The same hit prints a different E-value in each release, and a different one again if the program is rerun on a subset. Pinning $Z$ makes the subset run print the full\nobreakdash -run value. (Illustrative $P$; $Z$ values are Pfam 38.1, 38.2, and one proteome's candidate subset.)}}{3}{figure.caption.3}\protected@file@percent }
\newlabel{fig:pin}{{2}{3}{\textbf {Why old results cannot simply be reused.} An E-value is a probability $P$ (fixed by the score) times the database size $Z$. The same hit prints a different E-value in each release, and a different one again if the program is rerun on a subset. Pinning $Z$ makes the subset run print the full\nobreakdash -run value. (Illustrative $P$; $Z$ values are Pfam 38.1, 38.2, and one proteome's candidate subset.)}{figure.caption.3}{}}
\newlabel{fig:pin@cref}{{[figure][2][]2}{[1][3][]3}{}{}{}}
