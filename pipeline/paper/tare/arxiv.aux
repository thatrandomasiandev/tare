\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {How TARE\xspace  updates an annotation.} Blue boxes do work; gray boxes are decision points. The top row decides whether the program's coupling can be neutralized; the bottom row reruns the unmodified program on candidates only and checks the result. Dashed arrows read stored state. Every refusal (red) leads to a full stock run, so a user always receives the program's own output. A shipped replay is exact under the contract; finite checks do not prove the contract.}}{5}{figure.caption.9}\protected@file@percent }
\newlabel{fig:pipeline}{{3}{5}{\textbf {How \sys updates an annotation.} Blue boxes do work; gray boxes are decision points. The top row decides whether the program's coupling can be neutralized; the bottom row reruns the unmodified program on candidates only and checks the result. Dashed arrows read stored state. Every refusal (red) leads to a full stock run, so a user always receives the program's own output. A shipped replay is exact under the contract; finite checks do not prove the contract}{figure.caption.9}{}}
\newlabel{fig:pipeline@cref}{{[figure][3][]3}{[1][4][]5}{}{}{}}
