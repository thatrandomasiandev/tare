\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Edits, not just new families, decide how much an update reruns.} Strict hashes of seven consecutive Pfam releases. Gray is unchanged. Light blue is edited and dark blue is new; both are what TARE\xspace  reruns. The label is $f_\Delta = (\text  {edited} + \text  {new}) / Z_{\text  {new}}$. Pfam 37.4$\rightarrow $38.0 reruns 93.1\% of the new release: 22{,}965 edited and 822 new, with 1{,}758 unchanged, of 25{,}545. Pfam 38.1$\rightarrow $38.2 reruns 13.4\%: 1{,}378 edited and 2{,}674 new, with 26{,}082 unchanged, of 30{,}134, the same pair as \cref  {fig:churn}. The smallest change is 37.3$\rightarrow $37.4, at 2.0\%.}}{9}{figure.caption.13}\protected@file@percent }
\newlabel{fig:pairs}{{6}{9}{\textbf {Edits, not just new families, decide how much an update reruns.} Strict hashes of seven consecutive Pfam releases. Gray is unchanged. Light blue is edited and dark blue is new; both are what \sys reruns. The label is $f_\Delta = (\text {edited} + \text {new}) / Z_{\text {new}}$. Pfam 37.4$\rightarrow $38.0 reruns 93.1\% of the new release: 22{,}965 edited and 822 new, with 1{,}758 unchanged, of 25{,}545. Pfam 38.1$\rightarrow $38.2 reruns 13.4\%: 1{,}378 edited and 2{,}674 new, with 26{,}082 unchanged, of 30{,}134, the same pair as \cref {fig:churn}. The smallest change is 37.3$\rightarrow $37.4, at 2.0\%}{figure.caption.13}{}}
\newlabel{fig:pairs@cref}{{[figure][6][]6}{[1][8][]9}{}{}{}}
