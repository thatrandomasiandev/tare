\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {Why DIAMOND cannot be replayed exactly.} DIAMOND stores database entries back to back, separated by a single byte. Its first filter examines a window of 16 bytes before and 32 after each short matching ``seed'' without stopping at the entry boundary (DIAMOND 2.2.5, \texttt  {finger\_print.h}). A seed near the start of entry B therefore reads the end of whichever entry precedes B. Removing that neighbor from the database changes the window and can drop B's hit. The neighbor pad adds A back, the file\nobreakdash -order neighbor of every candidate; B's line then reappears, the check sees a line change, and TARE\xspace  refuses (R5). Each of the six lines DIAMOND lost was restored by exactly one such neighbor.}}{10}{figure.caption.14}\protected@file@percent }
\newlabel{fig:diamond}{{7}{10}{\textbf {Why DIAMOND cannot be replayed exactly.} DIAMOND stores database entries back to back, separated by a single byte. Its first filter examines a window of 16 bytes before and 32 after each short matching ``seed'' without stopping at the entry boundary (DIAMOND 2.2.5, \texttt {finger\_print.h}). A seed near the start of entry B therefore reads the end of whichever entry precedes B. Removing that neighbor from the database changes the window and can drop B's hit. The neighbor pad adds A back, the file\nobreakdash -order neighbor of every candidate; B's line then reappears, the check sees a line change, and \sys refuses (R5). Each of the six lines DIAMOND lost was restored by exactly one such neighbor}{figure.caption.14}{}}
\newlabel{fig:diamond@cref}{{[figure][7][]7}{[1][9][]10}{}{}{}}
