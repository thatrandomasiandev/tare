\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Where the time goes.} Each bar is one update run, split into four stages; the black tick is a stock run on the same genome. Top (laptop, indicative): the first version, the median of three alternating runs, spent 668\,s in its safety check and was slower than stock; batching and sampling (two fresh genomes) cut the update to under a third of a stock run. Bottom (historical Bernoulli audit): the median\nobreakdash -time update of the genomes with the lowest, median, and highest speedup. Dotted ticks: the cost model's prediction for selection.}}{7}{figure.caption.11}\protected@file@percent }
\newlabel{fig:phases}{{4}{7}{\textbf {Where the time goes.} Each bar is one update run, split into four stages; the black tick is a stock run on the same genome. Top (laptop, indicative): the first version, the median of three alternating runs, spent 668\,s in its safety check and was slower than stock; batching and sampling (two fresh genomes) cut the update to under a third of a stock run. Bottom (historical Bernoulli audit): the median\nobreakdash -time update of the genomes with the lowest, median, and highest speedup. Dotted ticks: the cost model's prediction for selection}{figure.caption.11}{}}
\newlabel{fig:phases@cref}{{[figure][4][]4}{[1][7][]7}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {The cost model across release sizes.} Speedup $1/(a f_\Delta + c)$. (a) HMMER: the server fit from the nine historical Bernoulli\nobreakdash -audit genomes ($a = 0.973$, $c = 0.098$, solid) with that policy's median and 95\% CI (open diamond); the laptop fit ($a = 1.06$, $c = 0.152$, dashed) and its two updates (filled circles); the server model at the measured $f_\Delta $ of the other Pfam pairs (ticks); the bound $1/f_\Delta $ (dashed gray) and the server ceiling $1/c$ (dotted). (b) Infernal, with its own larger overhead: the first version (cross) and the shipped tool, medians of ten genomes with 95\% bootstrap CIs.}}{8}{figure.caption.12}\protected@file@percent }
\newlabel{fig:model}{{5}{8}{\textbf {The cost model across release sizes.} Speedup $1/(a f_\Delta + c)$. (a) HMMER: the server fit from the nine historical Bernoulli\nobreakdash -audit genomes ($a = 0.973$, $c = 0.098$, solid) with that policy's median and 95\% CI (open diamond); the laptop fit ($a = 1.06$, $c = 0.152$, dashed) and its two updates (filled circles); the server model at the measured $f_\Delta $ of the other Pfam pairs (ticks); the bound $1/f_\Delta $ (dashed gray) and the server ceiling $1/c$ (dotted). (b) Infernal, with its own larger overhead: the first version (cross) and the shipped tool, medians of ten genomes with 95\% bootstrap CIs}{figure.caption.12}{}}
