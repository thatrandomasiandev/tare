\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces \textbf  {The random pads miss coupling that is not a file\nobreakdash -order neighbor.} Each point is the fraction of trials the check refused, with a Wilson 95\% interval. Dashed curves are the random\nobreakdash -pad formula (\cref  {eq:miss}) for the forms it describes. File\nobreakdash -wide coupling sits at the top of the plot; hidden and distant coupling does not. With no coupling (C0), 0 of 200 trials were refused. C4's squares are offset slightly right so both markers at 1.0 stay visible. The audit did not run in these trials.}}{11}{figure.caption.18}\protected@file@percent }
\newlabel{fig:adversarial}{{8}{11}{\textbf {The random pads miss coupling that is not a file\nobreakdash -order neighbor.} Each point is the fraction of trials the check refused, with a Wilson 95\% interval. Dashed curves are the random\nobreakdash -pad formula (\cref {eq:miss}) for the forms it describes. File\nobreakdash -wide coupling sits at the top of the plot; hidden and distant coupling does not. With no coupling (C0), 0 of 200 trials were refused. C4's squares are offset slightly right so both markers at 1.0 stay visible. The audit did not run in these trials}{figure.caption.18}{}}
\newlabel{fig:adversarial@cref}{{[figure][8][]8}{[1][10][]11}{}{}{}}
